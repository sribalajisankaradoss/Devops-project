pipeline {
    agent {
        label  'Slave1'
    }

    stages {

        stage('Pull the code ') {
            steps {
                sh '''
                    rm -rf Devops-project
                    git branch: 'main', changelog: false, poll: false, url: 'https://github.com/sribalajisankaradoss/Devops-project.git'
                    
                '''
            }
        }
        stage('Change the DIR and clean package') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                sh '''
                        echo "Checking Maven installation..."

                        if command -v mvn >/dev/null 2>&1; then
                            echo "Maven is already installed."
                        else
                            echo "Maven is not installed. Installing Maven..."

                            sudo apt-get update
                            sudo apt-get install -y maven
                        fi

                        echo "Maven version:"
                        mvn --version

                        echo "Building Java application..."
                        mvn clean package
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                sh 'mvn test'
                    sh 'mvn compile'
                }
            }
        }
        stage('Compile') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh 'mvn compile'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh '''
                        echo "Building Docker image..."
                        docker build -t java-jenkins-docker:latest .
                    '''
                }
            }
        }

        stage('Docker Run') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh '''
                        echo "Starting Docker container..."
                        docker run --rm -d -p 9090:9090 java-jenkins-docker:latest
                    '''
                }
            }
        }
        stage('Docker tag') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh '''
                        docker tag java-jenkins-docker:latest bala29/java-jenkins-docker:latest
                    '''
                }
            }
        }
        stage('Docker login') {
            steps {
               withCredentials ([
                usernamePassword(
                    credentialsId : 'docker-creds-bala',
                    usernameVariable : 'DOCKER_USERNAME'
                    passwordVariable : 'DOCKER_PASSWORD'
                )
               ]){
                sh '''
                echo "$Docker_Password" | docker login \ 
                -u "$Docker_USERNAME" \ 
                --password--stdin
                '''
               }
            }
        }
        stage('Docker Image Push') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh '''
                        docker push bala29/java-jenkins-docker:latest
                    '''
                }
            }
        }
        stage('Docker Push') {
            steps {
                dir('Devops-project/3-java-jenkins-docker-app') {
                    sh '''
                        cleanWs()
                    '''
                }
            }
        }
    }
}
